{
  "name": "@omadia/dev-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "manifest.yaml"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "package": "node scripts/build-zip.mjs",
    "codegen:migrations": "node scripts/codegen-migrations.mjs",
    "clean": "rm -rf dist out .test-build *.tsbuildinfo"
  },
  "peerDependencies": {
    "@omadia/dev-platform-plugin-api": "*",
    "@omadia/plugin-api": "*",
    "express": "^5.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@omadia/dev-platform-plugin-api": "*",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "description": "The Omadia Dev Platform as an installable plugin — dev jobs, runner orchestration, the job pipeline, its own HTTP routes, chat tools and database migrations. Extracted from omadia core per epic byte5ai/omadia#470 (P3: the middleware tree).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/byte5ai/omadia-dev-platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/byte5ai/omadia-dev-platform.git",
    "directory": "packages/plugin"
  }
}
